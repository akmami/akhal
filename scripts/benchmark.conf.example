# akhal benchmark settings.
#
# Copy to benchmark.conf next to the script (or point at it with --config) and edit. 
# Every value here is the default, so an empty config behaves exactly like no config at all. 
# This file is sourced by bash, so it is shell syntax.


AKHAL="./akhal"


DATA_DIR="data"
GFA="$DATA_DIR/human_v38.gfa"       # the graph
VG_FILE="$DATA_DIR/human_v38.vg"    # the same graph in vg's native format
GAF="$DATA_DIR/human_v38.gaf"       # alignments against the graph
GAF_B="$DATA_DIR/human_v38.2.gaf"   # a second, different alignment set
READS="$DATA_DIR/hg002.fa"          # the reads those alignments came from

# the backbones the VCF and rGFA tasks work against, comma separated, no spaces.
# REF_CSV goes to akhal gfa2rgfa, REF_ALL to akhal extract vcf, and REF_P - the same names, one -p each - to vg deconstruct.
# REF_P is pasted into the command as it stands, so each name keeps its single quotes.
# "all" makes akhal use every P line, which vg cannot do, so the two vcf rows are only comparable when REF_CSV lists every P line.
# Left empty, REF_ALL falls back to REF_CSV, and REF_CSV to the first P line's name - which is what akhal itself defaults to
REF_CSV="$(printf 'chr%s,' {1..22} X Y)"
REF_CSV="${REF_CSV%,}"
REF_P=""
IFS=, read -ra ref_names <<< "$REF_CSV"
for n in "${ref_names[@]}"; do REF_P+=" -p '$n'"; done
unset ref_names n
REF_ALL="all"

# gaftools gfa2rgfa takes a genome rather than paths: the reference sample named in the W lines (GRCh38, CHM13, ...).
# Left empty, gaftools looks for it in the H lines
GAFTOOLS_REF=""

# where results, logs, scratch and any downloaded binaries go
OUTDIR="out"

# which tools to measure: any of akhal, gfatools, odgi, vg, gaftools, or "all"
TOOLS="all"

# threads for the tools that take them (akhal and gfatools are single-threaded, so this only ever helps odgi and vg)
THREADS=1

# runs per measurement; the median is reported. 3 is a reasonable floor for numbers you intend to publish, 1 for a quick look
REPEATS=1

# seconds a single run may take before it is killed and its row reads "timeout"; 0 lifts the limit.
# One day by default - the whole-genome graph puts some tools past that
TIMEOUT=86400
